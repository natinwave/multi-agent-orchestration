# Never commit resolved secrets. .env.example holds op:// references only.
.env
*.env
!.env.example
secrets/
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Site-specific config. Copy the .example and edit the copy; the template
# stays tracked so a pull never conflicts with your channel id.
config/voice.toml

# Runtime state lives in /srv/orchestration, never in the repo.
# This entry only catches an accidental local run.
srv/
run/

# OS
.DS_Store
