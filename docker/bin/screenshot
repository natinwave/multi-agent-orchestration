#!/usr/bin/env python3
"""Take a screenshot of a page.

    screenshot https://example.com                 -> screenshot.png
    screenshot https://example.com out.png
    screenshot https://example.com out.png --width 1280 --height 800

Exists so that photographing a page is one command rather than a research
project. It is also a worked example: copy it if you need something it
does not do.

The --no-sandbox is not optional here. Chromium's sandbox needs privileges
this container deliberately drops, so without it the browser refuses to
start and the error does not mention sandboxes.
"""

from __future__ import annotations

import argparse
import sys

BROWSER_ARGS = ["--no-sandbox", "--disable-dev-shm-usage"]


def main() -> int:
    parser = argparse.ArgumentParser(prog="screenshot", description=__doc__.splitlines()[0])
    parser.add_argument("url")
    parser.add_argument("output", nargs="?", default="screenshot.png")
    parser.add_argument("--width", type=int, default=1280)
    parser.add_argument("--height", type=int, default=900)
    parser.add_argument("--full-page", action="store_true", help="the whole scrollable page")
    parser.add_argument("--wait", type=float, default=1.0, help="seconds to settle after load")
    args = parser.parse_args()

    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        print("playwright is not installed in this image", file=sys.stderr)
        return 1

    with sync_playwright() as p:
        browser = p.chromium.launch(args=BROWSER_ARGS)
        page = browser.new_page(viewport={"width": args.width, "height": args.height})
        try:
            page.goto(args.url, wait_until="load", timeout=45_000)
            if args.wait:
                page.wait_for_timeout(args.wait * 1000)
            page.screenshot(path=args.output, full_page=args.full_page)
        finally:
            browser.close()

    print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
