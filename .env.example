# 1Password references ONLY. Never a resolved value.
#
# Two supported delivery paths, both host-side:
#
#   op run --env-file=.env -- ./scripts/bootstrap.sh
#   op read "op://Orchestration/claude-code/oauth_token" > /run/orchestration/secrets/claude-code/oauth_token
#
# bootstrap.sh materialises these into per-agent tmpfs directories under
# /run/orchestration/secrets/<agent>/. Containers mount only their own
# directory, read-only. Nothing here ever enters an image or a container's
# environment block.

# --- agent identity: claude-code -------------------------------------------
# Produced by `claude setup-token` on the host. Interactive; a human must run
# it while sitting at the machine. See README "What remains manual".
CLAUDE_CODE_OAUTH_TOKEN="op://Orchestration/claude-code/oauth_token"

# Optional: a GitHub token scoped to the repos this agent may push.
# Distinct from your personal `gh auth login` credential on purpose.
GH_TOKEN="op://Orchestration/claude-code/github_token"

# --- agent identity: hermes -------------------------------------------------
# Local OpenAI-compatible endpoint. Usually needs no key; set one if your
# server enforces it. STUB — see config/agents.toml.
HERMES_API_KEY="op://Orchestration/hermes/api_key"
