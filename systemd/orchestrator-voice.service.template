# The SIP listener, as a service.
#
# It has to be one. The listener never exits by design -- it waits for the
# phone to ring -- and anything that runs it in the foreground is holding a
# process forever. An agent relaying commands over chat cannot do that: its
# tool call times out, the process is killed with it, and the symptom is a
# phone that rings and rings while the webhook returns 502 from a tunnel
# whose target is gone.
#
# A user service, not a system one: nothing here needs root, and the
# secrets it reads belong to your user.
#
# Install (replacing the placeholder with your checkout):
#
#   mkdir -p ~/.config/systemd/user
#   sed "s|%REPO%|$PWD|g" systemd/orchestrator-voice.service.template \
#     > ~/.config/systemd/user/orchestrator-voice.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now orchestrator-voice
#
# Then, so it keeps running when you are not logged in:
#
#   sudo loginctl enable-linger "$USER"
#
# Watch it:  journalctl --user -u orchestrator-voice -f
# Restart:   systemctl --user restart orchestrator-voice
# Stop:      systemctl --user stop orchestrator-voice

[Unit]
Description=Orchestrator voice bridge (SIP)
Documentation=https://github.com/natinwave/multi-agent-orchestration
# Only ordering, not a hard dependency: the listener retries by itself, and
# refusing to start without the network would be worse than backing off.
After=network-online.target
Wants=network-online.target

# Do not give up after the usual burst limit of five starts in ten
# seconds. Credentials live on a tmpfs wiped every boot and refilled by
# bootstrap.sh, so after a restart this fails until that has run -- and a
# phone line that stops retrying is a phone line that is quietly dead.
#
# These are [Unit] keys. systemd ignores them in [Service] with only a log
# line to say so, which is how they sat here doing nothing.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
WorkingDirectory=%REPO%
# Add --verbose to see every event crossing the wire while diagnosing a
# call. It raises only this project's logging, not the websocket
# library's, so the journal stays readable and raw frames stay out of it.
ExecStart=%REPO%/bin/orchestrate-voice --transport sip

# Credentials live on a tmpfs that is wiped every boot and refilled by
# bootstrap.sh, so after a restart this will fail until that has run. That
# is why it retries rather than giving up: once the secrets are back, the
# next attempt succeeds and the phone works again with nobody intervening.
Restart=always
RestartSec=15

# Journald gets the log; the listener writes plain lines with timestamps.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orchestrator-voice

# It reads secrets and talks to the network. It has no business writing
# anywhere but its own runtime directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
